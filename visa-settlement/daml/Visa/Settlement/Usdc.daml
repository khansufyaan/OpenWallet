-- | A deliberately simple USDC holding model.
--
-- This is a plain Daml template, NOT an implementation of the Canton Network
-- token standard (CIP-56) `Holding` interfaces. It captures just enough of a
-- stablecoin holding (issuer-signed, owner-controlled, splittable, mergeable)
-- to demonstrate atomic multilateral net settlement.
module Visa.Settlement.Usdc where

import DA.List (dedup)

-- | A USDC balance on ledger. The token issuer (e.g. Circle) is the sole
-- signatory; the owner controls transfers. `observers` lets the owner
-- disclose a holding to a counterparty (e.g. Visa Treasury) ahead of
-- settlement without giving up control.
template UsdcHolding
  with
    issuer : Party
    owner : Party
    amount : Decimal
    observers : [Party]
  where
    signatory issuer
    observer owner, observers
    ensure amount > 0.0

    -- | Move the full holding to a new owner. Observers are reset so the
    -- previous counterparties stop seeing the funds once they change hands.
    choice Transfer : ContractId UsdcHolding
      with
        newOwner : Party
      controller owner
      do create this with owner = newOwner, observers = []

    -- | Carve out an exact amount, optionally disclosing the carved-out part
    -- to additional parties. Returns (allocated part, optional remainder).
    choice Allocate : (ContractId UsdcHolding, Optional (ContractId UsdcHolding))
      with
        allocateAmount : Decimal
        discloseTo : [Party]
      controller owner
      do
        assertMsg "allocation must be positive" (allocateAmount > 0.0)
        assertMsg "insufficient funds for allocation" (allocateAmount <= amount)
        remainder <-
          if allocateAmount == amount
            then pure None
            else Some <$> create this with amount = amount - allocateAmount
        allocated <- create this with
          amount = allocateAmount
          observers = dedup (discloseTo ++ observers)
        pure (allocated, remainder)

    -- | Consolidate another holding of the same issuer and owner into this one.
    choice Merge : ContractId UsdcHolding
      with
        otherCid : ContractId UsdcHolding
      controller owner
      do
        other <- fetch otherCid
        assertMsg "can only merge holdings of the same issuer" (other.issuer == issuer)
        assertMsg "can only merge holdings of the same owner" (other.owner == owner)
        archive otherCid
        create this with amount = amount + other.amount

    -- | Pay an exact amount to a recipient, keeping the change, and record a
    -- TransferNote so both parties hold a durable payment history.
    choice Send : (ContractId UsdcHolding, Optional (ContractId UsdcHolding))
      with
        recipient : Party
        sendAmount : Decimal
        memo : Text
      controller owner
      do
        assertMsg "send amount must be positive" (sendAmount > 0.0)
        assertMsg "insufficient funds in this holding" (sendAmount <= amount)
        remainder <-
          if sendAmount == amount
            then pure None
            else Some <$> create this with amount = amount - sendAmount
        sent <- create this with owner = recipient, amount = sendAmount, observers = []
        now <- getTime
        _ <- create TransferNote with
          sender = owner; recipient; amount = sendAmount; sentAt = now; memo
        pure (sent, remainder)

-- | Durable record of a payment, visible to exactly the two parties involved.
template TransferNote
  with
    sender : Party
    recipient : Party
    amount : Decimal
    sentAt : Time
    memo : Text
  where
    signatory sender
    observer recipient
